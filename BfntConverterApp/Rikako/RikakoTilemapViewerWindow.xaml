<Window
    x:Class="BfntConverterApp.Rikako.RikakoTilemapViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:BfntConverterApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="clr-namespace:WPFUI.Controls;assembly=WPFUI"
    Title="Rikako 地图块查看器"
    Width="1010"
    Height="602"
    MinWidth="804"
    MinHeight="489"
    Style="{StaticResource UiWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <wpfui:TitleBar
            x:Name="TitleBar"
            Title="Rikako 地图块查看器"
            Grid.Row="0"
            ApplicationNavigation="False" />

        <Menu Grid.Row="1" Background="Transparent">
            <MenuItem Header="文件(_F)">
                <MenuItem Click="LoadMap_Click" Header="载入地图文本(_M)..." />
                <Separator />
                <MenuItem Click="Close_Click" Header="关闭(_X)" />
            </MenuItem>
            <MenuItem Click="About_Click" Header="关于(_H)" />
        </Menu>

        <local:ZoomBorder
            x:Name="PreviewZoomBorder"
            Grid.Row="2"
            Background="Transparent"
            ClipToBounds="True">
            <Canvas
                x:Name="PreviewCanvas"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Image
                    x:Name="PreviewImage"
                    RenderOptions.BitmapScalingMode="NearestNeighbor"
                    Stretch="None" />
            </Canvas>
        </local:ZoomBorder>

        <TextBox
            x:Name="MapTextBox"
            Grid.Row="3"
            Margin="16"
            AcceptsReturn="True"
            AcceptsTab="True"
            FontFamily="Consolas"
            FontSize="14"
            HorizontalScrollBarVisibility="Auto"
            TextChanged="MapTextBox_TextChanged"
            VerticalScrollBarVisibility="Auto"
            TextWrapping="NoWrap" />

        <Grid Grid.Row="4" Margin="16,0,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="PreviousSectionButton"
                Grid.Column="0"
                Width="96"
                Click="PreviousSection_Click"
                Content="&lt; Previous" />
            <TextBlock
                x:Name="SectionNumberTextBlock"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="Section: 0/0" />
            <Button
                x:Name="NextSectionButton"
                Grid.Column="2"
                Width="96"
                Click="NextSection_Click"
                Content="Next &gt;" />
        </Grid>
    </Grid>
</Window>
